rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ────────────────────────────────────────────────────────
    // Source of truth for role checks: request.auth.token.role
    // (populated by setCustomUserClaims; client cannot forge).
    function isSignedIn()      { return request.auth != null; }
    function roleOf()          { return request.auth.token.role; }
    function isOwner()         { return isSignedIn() && roleOf() == 'owner'; }
    function isAdmin()         { return isSignedIn() && roleOf() == 'admin'; }
    function isOwnerOrAdmin()  { return isOwner() || isAdmin(); }
    function isSelf(uid)       { return isSignedIn() && request.auth.uid == uid; }

    // ── Account helpers (spec 008) ──────────────────────────────────────────
    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    // The users/{uid} mirror exists and is not deactivated. A missing
    // `status` means active (no backfill). This is the only rules get();
    // it runs on profile writes only.
    function isActiveMember(uid) {
      return exists(userDocPath(uid))
          && get(userDocPath(uid)).data.get('status', 'active') == 'active';
    }

    // Field-level validation of a profiles/{uid} document. Limits mirror
    // src/services/profile-validation.ts.
    // First/last name (2026-10-02): a letter, then letters, spaces and
    // ' . - (mirrors NAME_PART_PATTERN in profile-validation.ts).
    function isValidNamePart(v) {
      return v is string
          && v == v.trim()
          && v.size() >= 1
          && v.size() <= 30
          && v.matches('^\\p{L}[\\p{L}\\p{M} .\'-]*$');
    }

    // Both or neither (profiles saved before the split have neither); when
    // present, displayName must be exactly "First Last".
    function hasValidNameParts(data) {
      return (!('firstName' in data) && !('lastName' in data))
          || (isValidNamePart(data.get('firstName', null))
              && isValidNamePart(data.get('lastName', null))
              && data.displayName == data.firstName + ' ' + data.lastName);
    }

    function isValidProfile(data) {
      return hasValidNameParts(data)
          && data.displayName is string
          && data.displayName == data.displayName.trim()
          && data.displayName.size() >= 1
          && data.displayName.size() <= 60
          && (!('phone' in data)
              || (data.phone is string && data.phone.matches('^[0-9+() .-]{7,20}$')))
          && data.termsVersion is string
          && data.termsVersion.size() >= 1
          && data.termsVersion.size() <= 20
          && data.adultAttested == true
          && data.acceptedTermsAt is timestamp
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    // ── Email topics (spec 011) ─────────────────────────────────────────────
    // Mirrors NOTIFICATION_TOPICS in src/types/notifications.ts.
    function isValidTopics(t) {
      return t is map
          && t.keys().hasOnly(['news', 'scores', 'schedule', 'requests'])
          && (!('news' in t) || t.news is bool)
          && (!('scores' in t) || t.scores is bool)
          && (!('schedule' in t) || t.schedule is bool)
          && (!('requests' in t) || t.requests is bool);
    }

    // ── League request helpers (spec 009) ───────────────────────────────────
    // Request doc ids are "{year}_{uid}"; the owner is read from the id so a
    // member can probe for their own (possibly missing) request.
    function isRequestOwner(id) {
      return isSignedIn()
          && id.split('_').size() == 2
          && id.split('_')[1] == request.auth.uid;
    }

    // Requests target this calendar year's season or next year's.
    function isRegistrationYear(y) {
      return y is int && (y == request.time.year() || y == request.time.year() + 1);
    }

    function DEPENDENT_KEYS() {
      return ['firstName', 'lastName', 'birthYear', 'createdAt', 'updatedAt'];
    }

    // Under 18 = born no earlier than (this year - 18); birth year only.
    // Limits mirror src/services/league-validation.ts.
    function isValidDependent(data) {
      return isValidNamePart(data.firstName)
          && isValidNamePart(data.lastName)
          && data.birthYear is int
          && data.birthYear >= request.time.year() - 18
          && data.birthYear <= request.time.year()
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function REGISTRATION_KEYS() {
      return ['uid', 'year', 'dependentIds', 'preferredLeagueTeamId', 'note', 'status',
              'createdAt', 'updatedAt'];
    }

    // Element checks on dependentIds happen at M3 placement (rules can't
    // iterate a list).
    function isValidRegistration(data) {
      return data.dependentIds is list
          && data.dependentIds.size() <= 6
          && (data.preferredLeagueTeamId == null
              || (data.preferredLeagueTeamId is string
                  && data.preferredLeagueTeamId.size() >= 1
                  && data.preferredLeagueTeamId.size() <= 100))
          && (data.note == null || (data.note is string && data.note.size() <= 280));
    }

    function isValidLinkRequest(data) {
      return data.shooterName is string
          && data.shooterName == data.shooterName.trim()
          && data.shooterName.size() >= 1
          && data.shooterName.size() <= 60
          && (!('note' in data) || (data.note is string && data.note.size() <= 280));
    }

    // ── users/{uid} — RBAC mirror ───────────────────────────────────────────
    // Written server-side by the onUserCreate trigger and the setUserRole
    // callable / scripts/set-role.js CLI. Clients may read their own doc
    // and (for owner/admin) read the list.
    //
    // Client writes are locked to the single legitimate flow: the
    // touchLastSignIn self-update of session timestamps. Identity fields
    // (email, displayName, photoURL) and role are server-only — a
    // client-mutable identity mirror would allow impersonation in the
    // admin Users tab, the exact UI used to grant roles.
    match /users/{uid} {
      allow read:   if isSelf(uid) || isOwnerOrAdmin();
      // onUserCreate seeds the doc server-side (Admin SDK bypasses rules);
      // there is no legitimate client create path.
      allow create: if false;
      // Self-update may touch only session timestamps.
      allow update: if isSelf(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastSignInAt', 'updatedAt']);
      allow delete: if false;
    }

    // ── profiles/{uid} — member-editable profile (spec 008) ─────────────────
    // Private: self or owner/admin. Writes require an active users/{uid}
    // mirror, so a deactivated member (or a deleted member's still-valid
    // token) cannot write. Delete is Admin SDK only (deleteAccount).
    match /profiles/{uid} {
      allow read:   if isSelf(uid) || isOwnerOrAdmin();
      allow create: if isSelf(uid)
                    && isActiveMember(uid)
                    && request.resource.data.keys().hasOnly([
                         'firstName', 'lastName', 'displayName', 'phone', 'acceptedTermsAt',
                         'termsVersion', 'adultAttested', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasAll([
                         'firstName', 'lastName', 'displayName', 'acceptedTermsAt',
                         'termsVersion', 'adultAttested', 'createdAt', 'updatedAt'])
                    && isValidProfile(request.resource.data)
                    && request.resource.data.acceptedTermsAt == request.time
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
                    && isActiveMember(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'firstName', 'lastName', 'displayName', 'phone', 'acceptedTermsAt',
                         'termsVersion', 'updatedAt'])
                    // Once split, the name parts can change but not be removed.
                    && (!('firstName' in resource.data) || 'firstName' in request.resource.data)
                    && isValidProfile(request.resource.data)
                    && request.resource.data.updatedAt == request.time
                    && (!('acceptedTermsAt' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.acceptedTermsAt == request.time)
                    // A new termsVersion is only recorded with a fresh acceptance.
                    && (!('termsVersion' in request.resource.data.diff(resource.data).affectedKeys())
                        || 'acceptedTermsAt' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      // ── profiles/{uid}/dependents/{depId} — under-18 shooters (spec 009) ──
      // Owned by the guardian. Minors never hold accounts; the full name stays
      // here (private) and rosters carry "First L." only.
      match /dependents/{depId} {
        allow read:   if isSelf(uid) || isOwnerOrAdmin();
        allow create: if isSelf(uid)
                      && isActiveMember(uid)
                      && request.resource.data.keys().hasOnly(DEPENDENT_KEYS())
                      && request.resource.data.keys().hasAll(DEPENDENT_KEYS())
                      && isValidDependent(request.resource.data)
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;
        allow update: if isSelf(uid)
                      && isActiveMember(uid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['firstName', 'lastName', 'birthYear', 'updatedAt'])
                      && isValidDependent(request.resource.data)
                      && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(uid);
      }
    }

    // ── leagueTeams/{teamId} — persistent team identity (spec 009) ──────────
    // Backfilled from season team doc ids; captainUid is set by M3 Functions.
    match /leagueTeams/{teamId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── teamProposals/{year}_{uid} — captain roster proposals (spec 009) ────
    // Written only by the teamProposal callable (rules can't validate a
    // roster list). The doc id carries the captain's uid, so a read of a
    // proposal that doesn't exist yet is still allowed for its captain.
    match /teamProposals/{proposalId} {
      allow read:  if isRequestOwner(proposalId) || isOwnerOrAdmin();
      allow write: if false;
    }

    // ── registrations/{year}_{uid} — individual registration (spec 009) ─────
    // One per member per season. A member can't hold a team proposal and a
    // registration for the same season. Placement is M3 (Functions).
    match /registrations/{regId} {
      allow read:   if isRequestOwner(regId) || isOwnerOrAdmin();
      allow create: if isSignedIn()
                    && regId == string(request.resource.data.year) + '_' + request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && isActiveMember(request.auth.uid)
                    && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
                    && !exists(/databases/$(database)/documents/teamProposals/$(regId))
                    && request.resource.data.keys().hasOnly(REGISTRATION_KEYS())
                    && request.resource.data.keys().hasAll(REGISTRATION_KEYS())
                    && isRegistrationYear(request.resource.data.year)
                    && isValidRegistration(request.resource.data)
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isRequestOwner(regId)
                    && resource.data.status == 'submitted'
                    && isActiveMember(request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['dependentIds', 'preferredLeagueTeamId', 'note', 'updatedAt'])
                    && isValidRegistration(request.resource.data)
                    && request.resource.data.updatedAt == request.time;
      // Spec 010 AC-20: a declined request can be cleared to ask again.
      allow delete: if isRequestOwner(regId) && resource.data.status in ['submitted', 'declined'];
    }

    // ── shooterLinkRequests/{uid} — link to a scorecard name (spec 009) ─────
    // Review (approved | declined) is M3 (Functions).
    match /shooterLinkRequests/{uid} {
      allow read:   if isSelf(uid) || isOwnerOrAdmin();
      allow create: if isSelf(uid)
                    && isActiveMember(uid)
                    && request.resource.data.keys().hasOnly(['shooterName', 'note', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['shooterName', 'status', 'createdAt', 'updatedAt'])
                    && isValidLinkRequest(request.resource.data)
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
                    && isActiveMember(uid)
                    && resource.data.status == 'submitted'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['shooterName', 'note', 'updatedAt'])
                    && isValidLinkRequest(request.resource.data)
                    && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid) && resource.data.status in ['submitted', 'declined'];
    }

    // ── shooterLinks/{uid} — approved links, reserved for M3 ────────────────
    match /shooterLinks/{uid} {
      allow read:  if isSelf(uid) || isOwnerOrAdmin();
      allow write: if false;
    }

    // ── captainChanges/{leagueTeamId} — captain handoff (spec 010 AC-17) ────
    // Written only by the captainHandoff and reviewRequest callables. The
    // nominating captain and the nominee can read it (members query with
    // where fromUid == or where toUid == their uid).
    match /captainChanges/{leagueTeamId} {
      allow read:  if isSignedIn()
                   && (resource.data.fromUid == request.auth.uid
                       || resource.data.toUid == request.auth.uid
                       || isOwnerOrAdmin());
      allow write: if false;
    }

    // ── notificationSettings/{uid} — reserved for M4 ────────────────────────
    // ── notificationSettings/{uid} — email topics (spec 011) ───────────────
    // Self only. Missing topics mean off. The unsubscribe function and
    // deleteAccount write through the Admin SDK.
    match /notificationSettings/{uid} {
      allow read:           if isSelf(uid);
      allow create, update: if isSelf(uid)
                            && isActiveMember(uid)
                            && request.resource.data.keys().hasOnly(['topics', 'updatedAt'])
                            && request.resource.data.keys().hasAll(['topics', 'updatedAt'])
                            && isValidTopics(request.resource.data.topics)
                            && request.resource.data.updatedAt == request.time;
      allow delete:         if false;
    }

    // ── mail/{id}, notifications/{key} — email queue and fan-out dedupe ────
    // Server-only (spec 011 AC-7, AC-11).
    match /mail/{id} {
      allow read, write: if false;
    }
    match /notifications/{key} {
      allow read, write: if false;
    }

    // ── audit/{id} — append-only role-change and account-status log ─────────
    match /audit/{id} {
      allow read:  if isOwner();
      allow write: if false;
    }

    // ── rateLimits/** — Function-internal counters ──────────────────────────
    match /rateLimits/{path=**} {
      allow read:  if isOwner();
      allow write: if false;
    }

    // ── config/banner — the only config doc that exists ─────────────────────
    // Scoped to the banner doc rather than /config/{doc} so future config
    // docs (which may not be public) start implicit-deny; add an explicit
    // match block when a new config doc ships (F-53).
    match /config/banner {
      allow read:           if true;
      allow create, update: if isOwnerOrAdmin();
    }

    // ── config/mailDigest — requestDigest's last run (spec 011 AC-19) ───────
    match /config/mailDigest {
      allow read, write: if false;
    }

    // ── announcements/{docId} ──────────────────────────────────────────────
    match /announcements/{docId} {
      allow read:                   if true;
      allow create, update, delete: if isOwnerOrAdmin();
    }

    // ── seasons/{year} and subcollections ──────────────────────────────────
    match /seasons/{year} {
      allow read:           if true;
      allow create, update: if isOwnerOrAdmin();

      match /teams/{teamId} {
        allow read:                   if true;
        allow create, update, delete: if isOwnerOrAdmin();
      }

      match /weeks/{weekNumber} {
        allow read:           if true;
        allow create, update: if isOwnerOrAdmin();
      }

      match /entries/{entryId} {
        // Drafts are owner/admin-only end-to-end.
        allow read:                   if isOwnerOrAdmin();
        allow create, update, delete: if isOwnerOrAdmin();
      }
    }
  }
}
