# Firebase Configuration
# Replace placeholder values with your actual Firebase project configuration.
# Get these values from Firebase Console > Project Settings > General > Your apps.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=citl-baed2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=citl-baed2
VITE_FIREBASE_STORAGE_BUCKET=citl-baed2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Environment
NODE_ENV=development

# Sign-in providers (spec 008)
# Comma-separated list of the methods the sign-in dialog offers:
#   google, email
# Unset or empty means both. Each provider must also be enabled in
# Firebase console > Authentication > Sign-in method.
VITE_AUTH_PROVIDERS=google,email

# League requests (specs 009/010): dependents, team proposals, registration,
# shooter links, and captain handoff on /account. Turning it on also raises
# the terms version, so members re-accept (spec 010 AC-22). Unset means on
# only with VITE_USE_EMULATOR=true. CI reads the repository variable of the
# same name (deploy-production.yml, deploy-preview.yml).
# VITE_LEAGUE_REQUESTS=false

# App Check (deployed builds)
# reCAPTCHA Enterprise site key (Score-based). Domain verification is ON:
# the key mints tokens only on its allowed domains — citl.club,
# www.citl.club, citl-baed2.web.app, citl-baed2.firebaseapp.com,
# citl-preview.web.app (PR previews), and localhost. Firebase Hosting
# preview channels (citl-baed2--*.web.app) are NOT covered; use
# `npm run deploy:preview`, which deploys to citl-preview.web.app.
# Leave unset for emulator-only local dev — App Check init is skipped
# when VITE_USE_EMULATOR=true.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token — LOCAL DEV SERVER ONLY (`npm run dev:prod` from
# an origin not on the key's list, e.g. 127.0.0.1 or a LAN address;
# localhost:3000 doesn't need it). The client reads it only under the
# Vite dev server, so `vite build` never ships it. Register your own token
# under Firebase Console → App Check → Apps → Manage debug tokens, keep it
# in your local .env, and revoke it when done. Never put it in CI:
# scripts/check-app-check-debug.js fails any workflow that references it.
# VITE_APP_CHECK_DEBUG_TOKEN=

# Local emulator suite
# `npm run dev` sets this automatically; do not set it for production builds.
# When true, Auth, Firestore, and Functions SDKs connect to:
#   auth      127.0.0.1:9099
#   firestore 127.0.0.1:8080
#   functions 127.0.0.1:5001
# App Check init is also skipped in emulator mode.
# VITE_USE_EMULATOR=true

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Go to https://console.firebase.google.com
# 3. Select the "citl-baed2" project
# 4. Go to Project Settings (gear icon) > General > Your apps
# 5. Copy the config values and replace the placeholders above
# 6. (deployed builds) Paste the existing reCAPTCHA Enterprise site key
#    (Firebase console > App Check > Apps) into
#    VITE_RECAPTCHA_ENTERPRISE_SITE_KEY above.
